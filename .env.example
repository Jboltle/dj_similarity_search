# Override the auto-detected VirtualDJ paths if needed.
# Defaults (macOS):
#   VDJ_DB_PATH=~/Library/Application Support/VirtualDJ/database.xml
#   VDJ_EXTRA_DB_PATH=~/Library/Application Support/VirtualDJ/extra.db
#   VDJ_HISTORY_PATH=~/Library/Application Support/VirtualDJ/History
# Defaults (Windows):
#   VDJ_DB_PATH=%USERPROFILE%\Documents\VirtualDJ\database.xml
#   VDJ_EXTRA_DB_PATH=%USERPROFILE%\Documents\VirtualDJ\extra.db
#   VDJ_HISTORY_PATH=%USERPROFILE%\Documents\VirtualDJ\History

VDJ_DB_PATH=
VDJ_EXTRA_DB_PATH=
VDJ_HISTORY_PATH=
# Optional: base folder for all VDJ data (used by clone + path resolution).
# When set, database.xml / extra.db / History resolve under this folder unless overridden above.
# macOS default: ~/Library/Application Support/VirtualDJ
# Windows default: %USERPROFILE%\Documents\VirtualDJ
VDJ_FOLDER=
# 1. Register a new app at https://soundcloud.com/you/apps
# 2. Deploy public/oauth-callback.html to a public GitHub Pages repo and set
#    SOUNDCLOUD_REDIRECT_URI to that HTTPS URL (must end with `/`).
# 3. Register the SAME URL as the redirect_uri in the SoundCloud app form.
#
# SoundCloud has required https:// for redirect URIs since Oct 2024;
# loopback http://127.0.0.1 will NOT work.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=https://YOUR-USERNAME.github.io/djlinker-callback/
