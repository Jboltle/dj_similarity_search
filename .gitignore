# Optional: nested git in deploy/djlinker-callback (standalone GitHub Pages clone)
deploy/djlinker-callback/.git/

node_modules
dist
.DS_Store
*.log
.env
.env.local
bun.lock
# Generated artifacts — regenerable from sync/ + your VirtualDJ folder.
public/graph.json
public/unresolved-links.json
public/link-shape-report.json
public/soundcloud-playlist.json

# Backups for sync:pull / sync:push / linked:folder — never auto-deleted, never committed
public/backups/

# OAuth tokens (NEVER commit these)
.soundcloud-tokens.json

# sync/ IS tracked (per-machine snapshots + merged result), but the SQLite
# WAL/SHM sidecars are transient and machine-specific — never commit them.
sync/**/*.db-wal
sync/**/*.db-shm
sync/**/.DS_Store

# Stray test artifacts at repo root
.tmp/
.tmp-*
