{
  "name": "vdj-link-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "Read-only VirtualDJ database explorer that visualizes linked tracks as a Three.js force-directed graph.",
  "scripts": {
    "parse": "node scripts/parse-vdj-db.js",
    "validate": "node scripts/validate-graph.js",
    "build:data": "node scripts/parse-vdj-db.js && node scripts/validate-graph.js",
    "inspect": "node scripts/inspect-link-shape.js",
    "sync:merge": "node scripts/sync-merge.js",
    "sync:push": "node scripts/sync-push.js",
    "sync:pull": "node scripts/sync-pull.js",
    "sync:restore": "node scripts/sync-restore.js",
    "linked:folder": "node scripts/build-linked-folder.js",
    "upload:soundcloud": "node scripts/upload-to-soundcloud.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dev:app": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "fast-xml-parser": "^4.5.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.0",
    "wait-on": "^9.1.0"
  }
}
